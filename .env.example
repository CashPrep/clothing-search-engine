# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/clothing_search"

# Redis (Upstash or local)
REDIS_URL="redis://localhost:6379"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Affiliate Network API Keys
CJ_API_KEY=""               # Commission Junction
RAKUTEN_API_KEY=""          # Rakuten Advertising
IMPACT_ACCOUNT_SID=""       # Impact.com
IMPACT_AUTH_TOKEN=""        # Impact.com
SHARE_A_SALE_API_KEY=""     # ShareASale
AWIN_API_KEY=""             # Awin

# Optional: Coupon APIs
HONEY_API_KEY=""            # Honey/PayPal
RETAILMENOT_API_KEY=""      # RetailMeNot

# Optional: Product Data APIs
SERP_API_KEY=""             # SerpApi (Google Shopping)
PRICESPY_API_KEY=""         # PriceSpy
PRICECHARTR_API_KEY=""      # Pricechartr

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NODE_ENV="development"
